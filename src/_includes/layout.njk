<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Organifanten | Put the elephants to work</title>
    <meta
      name="description"
      content="Organifanten helps you intentionally use the shortcuts of brains, the unwritten rules of your culture, and the gravity of your bureaucracy to accelerate change — instead of fighting inertia."
    />
    <meta property="og:title" content="Organifanten" />
    <meta
      property="og:description"
      content="Consulting for the three elephants in every meeting room: Brain, Culture, Bureaucracy."
    />
    <meta property="og:url" content="https://organifanten.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="{{ '/styles/index.css' | bust }}" />
    <link
      rel="icon"
      type="image/x-icon"
      href="/assets/favicon.ico"
      sizes="any"
    />
    {% if site.isProd %}
      {% include "analytics-loader.njk" %}
    {% endif %}
  </head>
  <body class="bg-base-100 text-base-content min-h-screen font-sans">
    {% include "nav.njk" %}
    {% if noContentWrap %}
      <div class="text-lg">{{ content | safe }}</div>
    {% else %}
      <div class="prose mx-auto my-10 max-w-3xl px-6">{{ content | safe }}</div>
    {% endif %}
    {% include "footer.njk" %}
    {% if site.isProd %}
      {% include "consent-banner.njk" %}
    {% endif %}
    <script src="/assets/code-copy.js" defer></script>
  </body>
</html>
