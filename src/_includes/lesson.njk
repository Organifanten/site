---
layout: layout.njk
---

<div class="max-w-3xl mx-auto px-6 py-20">
  <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Lesson {{ lessonNumber }}</p>
  <h1 class="text-3xl md:text-4xl font-semibold mb-8">{{ title }}</h1>

  <div class="card-bordered mb-12">
    <p class="font-medium mb-2">Learning outcome</p>
    <p class="opacity-80">{{ learningOutcome }}</p>
  </div>

  {{ content | safe }}

  <section class="mt-16 border-t border-base-300 pt-8">
    <h2 class="text-xl font-semibold mb-4">Reflection Questions</h2>
    <ul class="space-y-3 opacity-80">
      {% for q in reflectionQuestions %}
        <li>{{ q }}</li>
      {% endfor %}
    </ul>
  </section>

  <div class="mt-12 flex justify-between">
    {% if prev %}
      <a href="/resources/diy-team-building/{{ prev.slug }}/"
         class="btn-outline hover:bg-primary hover:text-primary-content">
        ← Previous lesson <br> {{ prev.title }}
      </a>
    {% else %}
      <div></div>
    {% endif %}
    {% if next %}
      <a href="/resources/diy-team-building/{{ next.slug }}/"
         class="btn-outline  hover:bg-primary hover:text-primary-content">
        Next lesson → <br> {{ next.title }}
      </a>
    {% else %}
      <a href="/resources/diy-team-building/"
         class="btn-outline hover:bg-primary hover:text-primary-content">
        Back to the Game →
      </a>
    {% endif %}
  </div>
</div>