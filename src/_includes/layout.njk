<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Organifanten | Put the elephants to work</title>
    <meta
      name="description"
      content="Organifanten helps you intentionally use the shortcuts of brains, the unwritten rules of your culture, and the gravity of your bureaucracy to accelerate change — instead of fighting inertia."
    />
    <meta property="og:title" content="Organifanten" />
    <meta
      property="og:description"
      content="Consulting for the three elephants in every meeting room: Brain, Culture, Bureaucracy."
    />
    <meta property="og:url" content="https://organifanten.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/styles/index.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/assets/favicon.ico"
      sizes="any"
    />
    {% if site.isProd %}
      {% include "analytics-loader.njk" %}
    {% endif %}
  </head>
  <body class="bg-base-100 text-base-content min-h-screen font-sans">
    {% include "nav.njk" %}
    {{ content | safe }}
    {% if site.isProd %}
      {% include "consent-banner.njk" %}
    {% endif %}
  </body>
</html>
