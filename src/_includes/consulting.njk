---
layout: layout.njk
---

<div class="bg-base-100 text-base-content flex min-h-screen flex-col">
  <div class="mx-auto w-full max-w-3xl flex-1 px-6 py-20">
    <a
      href="/consulting/"
      class="text-primary mb-4 inline-block text-sm font-semibold hover:underline"
      >← Back to Consulting</a
    >

    <h1 class="mb-2 text-4xl font-semibold md:text-5xl">{{ title }}</h1>
    <p class="mb-8 text-lg opacity-80">{{ subtitle }}</p>

    <div class="prose mb-12 max-w-none">{{ content | markdown | safe }}</div>

    <hr class="border-base-300 mb-8" />
    <p class="mb-4 opacity-80">Interested? I'm happy to talk it through.</p>
    <a href="mailto:hello@organifanten.com" class="btn btn-primary">
      Let's talk
    </a>
  </div>

  {% include "footer.njk" %}
</div>
