{% set elephantClass = "w-full h-auto" %}

<!-- HERO -->
<section class="py-12 md:py-20">
  <div class="mx-auto max-w-3xl px-6">
    <div class="mb-8 flex justify-center gap-6 md:gap-10">
      <div class="text-brain w-24 md:w-26">{% include "elephant.njk" %}</div>
      <div class="text-culture w-24 md:w-26">{% include "elephant.njk" %}</div>
      <div class="text-bureaucracy w-24 md:w-26">
        {% include "elephant.njk" %}
      </div>
    </div>
    <h1>There are elephants in the meeting room.</h1>
    <p>They quietly shape conversations, decisions, and change efforts.</p>
    <p>Do you know how to put them to work?</p>
  </div>
</section>

<!-- THREE ELEPHANTS DETAILED -->
