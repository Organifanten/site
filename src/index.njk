---
layout: layout.njk
---

<div class="min-h-screen bg-base-100 text-base-content">
  <!-- HERO -->
  <section class="py-12 md:py-20">
    <div class="text-center max-w-3xl mx-auto px-6">
      <div class="w-lg h-lg text-primary flex justify-center mx-auto mb-6">{% include "elephant.njk" %}</div>
      <h1 class="text-4xl md:text-5xl font-semibold leading-tight mb-6">
        Work <span class="text-primary underline">on</span> your organization<br>(not just in it).
      </h1>
      <a href="/consulting/session/" class="btn btn-primary text-lg">
        Book a Consulting Session
      </a>
    </div>
  </section>

  <!-- THREE PHILOSOPHY PILLARS -->
  <section class="py-20 bg-accent">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-semibold mb-12 text-center">Our approach</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Brain Budget -->
        <div class="rounded-xl bg-base-100 shadow-sm p-6">
          <h3 class="text-xl font-semibold text-primary mb-3">Brain Budget</h3>
          <p class="opacity-90">
            Brains conserve energy. Understanding this hidden driver of behavior changes everything about how you design interventions.
          </p>
        </div>

        <!-- Via Negativa -->
        <div class="rounded-xl bg-base-100 shadow-sm p-6">
          <h3 class="text-xl font-semibold text-primary mb-3">Via Negativa</h3>
          <p class="opacity-90">
            Remove friction and hidden constraints before adding frameworks. Subtract before you add.
          </p>
        </div>

        <!-- Humble Consulting -->
        <div class="rounded-xl bg-base-100 shadow-sm p-6">
          <h3 class="text-xl font-semibold text-primary mb-3">Humble Consulting</h3>
          <p class="opacity-90">
            Your next step is discovered together through structured questions, not prescribed top-down.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW THIS CHANGES YOUR WORK -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-semibold mb-8 text-center">How this changes your work</h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-lg opacity-90 text-center mb-8">
          From reaction to clarity. From adding solutions to removing constraints. From advice to discovery.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="border-l-4 border-primary pl-6">
          <p class="font-semibold text-primary mb-2">Before</p>
          <ul class="space-y-2 opacity-80">
            <li>React to the loudest problem</li>
            <li>Add new processes and tools</li>
            <li>Tell the team what to do</li>
          </ul>
        </div>
        <div class="border-l-4 border-success pl-6">
          <p class="font-semibold text-success mb-2">After</p>
          <ul class="space-y-2 opacity-80">
            <li>Understand the root pattern</li>
            <li>Remove what's really blocking</li>
            <li>Help the team find their way</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- OFFERS -->
  <section class="py-20 bg-accent">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-semibold mb-4 text-center">What we offer</h2>
      <p class="text-center opacity-80 mb-12 text-lg">
        Three ways to work together, depending on where you are.
      </p>
      
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <!-- Consulting Session -->
        <a href="/consulting/session/" class="group rounded-xl bg-base-100 shadow-sm p-6 hover:shadow-md transition">
          <h3 class="text-xl font-semibold text-primary mb-2 group-hover:underline">Consulting Session</h3>
          <p class="text-sm opacity-80 mb-4">90-minute thinking partnership</p>
          <p class="font-semibold text-lg">€500</p>
          <p class="text-xs opacity-60 mt-2">or €3k for a pass of 8</p>
        </a>

        <!-- Change Audit -->
        <a href="/consulting/change-audit/" class="group rounded-xl bg-base-100 shadow-sm p-6 hover:shadow-md transition">
          <h3 class="text-xl font-semibold text-primary mb-2 group-hover:underline">Change Audit</h3>
          <p class="text-sm opacity-80 mb-4">Diagnostic over 1 week</p>
          <p class="font-semibold text-lg">€5,000</p>
          <p class="text-xs opacity-60 mt-2">10 interviews + findings document</p>
        </a>

        <!-- Culture Portrait -->
        <a href="/consulting/culture-portrait/" class="group rounded-xl bg-base-100 shadow-sm p-6 hover:shadow-md transition">
          <h3 class="text-xl font-semibold text-primary mb-2 group-hover:underline">Culture Portrait</h3>
          <p class="text-sm opacity-80 mb-4">1-week organizational characterization</p>
          <p class="font-semibold text-lg">€5,000</p>
          <p class="text-xs opacity-60 mt-2">Before any change is designed</p>
        </a>
      </div>

      <!-- Free Resources Hook -->
      <div class="bg-base-100 rounded-xl p-8 text-center">
        <h3 class="text-xl font-semibold mb-2">Start with free resources</h3>
        <p class="opacity-80 mb-4">Explore our lessons and guides on team building and organizational work.</p>
        <a href="/resources/" class="text-primary font-semibold hover:underline">Browse Resources →</a>
      </div>
    </div>
  </section>

  {% include "footer.njk" %}

</div>
